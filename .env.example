# Copy to .env (git-ignored). Read by the backend only; never sent to the browser.

# TypeSafe API key for consensus judge B (Jev). Leave empty to disable judge B.
TYPESAFE_API_KEY=

# Optional overrides (defaults shown). These are read from the process
# environment, not from this file: set them in the shell. AIGORA_PORT is also
# read by the Vite dev proxy, so `AIGORA_PORT=8775 npm run dev --prefix frontend`
# moves both.
# AIGORA_HOST=127.0.0.1
# AIGORA_PORT=8765
# AIGORA_PARTICIPANTS_FILE=participants.toml
# AIGORA_DATA_DIR=data/discussions
