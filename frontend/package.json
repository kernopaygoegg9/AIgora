{
  "name": "aigora-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "uv run --directory ../backend aigora",
    "dev:frontend": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:backend": "uv run --directory ../backend pytest",
    "lint": "eslint . --max-warnings 0 && uv run --directory ../backend ruff check",
    "format": "prettier --write . && uv run --directory ../backend ruff check --select I --fix && uv run --directory ../backend ruff format",
    "format:check": "prettier --check . && uv run --directory ../backend ruff format --check",
    "check:fast": "npm run lint && npm run format:check && npm run test:backend && npm run typecheck",
    "check": "npm run lint && npm run format:check && npm run test:backend && npm run typecheck && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "dompurify": "^3.2.0",
    "markdown-it": "^14.1.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.50.0",
    "@types/markdown-it": "^14.1.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/tsconfig": "^0.7.0",
    "concurrently": "^9.1.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.0"
  }
}
